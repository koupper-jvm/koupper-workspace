{
  "name": "CortexAgent",
  "version": "1.0.0",
  "description": "Main CORTEX orchestrator — local LLM inference loop with MCP tool support and command bridge",
  "role": "AI orchestrator",
  "entrypoint": "cortex",
  "inputs": [],
  "outputs": ["cortex-session log stream"],
  "envVars": [
    { "name": "KOUPPER_LLM_MODEL_PATH", "required": true,  "description": "Path to .gguf model file" },
    { "name": "KOUPPER_LLM_EXECUTABLE", "required": false, "description": "Path to llama-server binary" },
    { "name": "CORTEX_JOBS_DIR",        "required": false, "description": "Jobs directory (default: ~/.koupper/jobs)" }
  ],
  "providers": ["InferenceEngine", "HtppClient", "MCPClientProvider", "CommandBridgeProvider"],
  "triggers": ["manual", "monitor-startup"],
  "tags": ["llm", "mcp", "cortex", "inference"],
  "persistent": true,
  "docs": "https://koupper.com/docs/agents/cortex"
}
