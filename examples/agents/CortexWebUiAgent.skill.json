{
  "name": "CortexWebUiAgent",
  "version": "1.0.0",
  "description": "Real-time web dashboard for the CORTEX swarm — serves job history, metrics, agent store and chat at http://localhost:18083",
  "role": "Dashboard server",
  "entrypoint": "setup",
  "inputs": [],
  "outputs": ["HTTP server on port 18083"],
  "envVars": [
    { "name": "CORTEX_JOBS_DIR", "required": false, "description": "Jobs directory (default: ~/.koupper/jobs)" },
    { "name": "CORTEX_WEB_PORT", "required": false, "description": "HTTP port (default: 18083)" }
  ],
  "providers": ["GrizzlyRuntimeRouterProvider"],
  "triggers": ["manual", "koupper-start"],
  "tags": ["dashboard", "web-ui", "sse", "monitoring"],
  "persistent": true,
  "docs": "https://koupper.com/docs/agents/cortex-web-ui"
}
